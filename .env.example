# Copy to .env and fill in. .env is git-ignored. NEVER commit real keys.
# Exposed IBM credentials get the hackathon account suspended.
BOB_API_KEY_TIM=
BOB_API_KEY_BERNARD=
BOB_API_KEY_JEREMY=
# Which key the console reviewer uses at runtime (BOB_API_KEY_JEREMY during testing, BOB_API_KEY_BERNARD for the recorded demo)
BOB_API_KEY=
# Bob Shell / inference endpoint, if one is needed (leave blank to use `bob run` defaults)
BOB_API_URL=
# Console
ORIGIT_CONSOLE_PORT=8787
ORIGIT_REPO_PATH=../demo/payments-api
